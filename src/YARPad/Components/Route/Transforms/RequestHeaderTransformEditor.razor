<MudStack Spacing="2">
    <TopToolTip Text="@Tooltips.Transforms_RequestHeader_Name">
        <MudTextField Label="ⓘ Request Header"
                      @bind-Value="Transform.RequestHeader"
                      For="@(() => Transform.RequestHeader)"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense" />
    </TopToolTip>

    <MudStack Row="true">
        <TopToolTip Text="@Tooltips.Transforms_RequestHeader_ChangeType" RootClass="mt-2">
            <MudToggleGroup T="HeaderTransformAction" @bind-Value="ActionType" Outlined="true" Delimiters="true" Size="Size.Medium" Color="@ColorResolver.Buttons.Toggle">
                <MudToggleItem Value="@HeaderTransformAction.Set">Replace</MudToggleItem>
                <MudToggleItem Value="@HeaderTransformAction.Append">Add</MudToggleItem>
                @* Remove is disabled beacuse Yarp validation at the moment requires Set or Append (even though schema allows Remove) *@
                <MudToggleItem Value="@HeaderTransformAction.Remove" Disabled="true">Remove</MudToggleItem>
            </MudToggleGroup>
        </TopToolTip>

        @if (ActionType == HeaderTransformAction.Set)
        {
            <TopToolTip Text="@Tooltips.Transforms_RequestHeader_Set" RootClass="d-flex flex-grow-1">
                <MudTextField Label="ⓘ Value"
                              @bind-Value="Transform.Set"
                              For="@(() => Transform.Set)"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense" />
            </TopToolTip>
        }
        else if (ActionType == HeaderTransformAction.Append)
        {
            <TopToolTip Text="@Tooltips.Transforms_RequestHeader_Append" RootClass="d-flex flex-grow-1">
                <MudTextField Label="ⓘ Value"
                              @bind-Value="Transform.Append"
                              For="@(() => Transform.Append)"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense" />
            </TopToolTip>
        }
    </MudStack>
</MudStack>

@code {
    [Parameter, EditorRequired]
    public required RequestHeaderTransform Transform { get; set; }

    private HeaderTransformAction ActionType
    {
        get
        {
            if (Transform.Set != null) return HeaderTransformAction.Set;
            if (Transform.Append != null) return HeaderTransformAction.Append;
            return HeaderTransformAction.Remove;
        }
        set
        {
            Transform.Set = null;
            Transform.Append = null;
            Transform.Remove = false;

            if (value == HeaderTransformAction.Set)
            {
                Transform.Set = string.Empty;
            }
            else if (value == HeaderTransformAction.Append)
            {
                Transform.Append = string.Empty;
            }
            else if (value == HeaderTransformAction.Remove)
            {
                Transform.Remove = true;
            }
        }
    }
}
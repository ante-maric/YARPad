 <TopToolTip Text="@Tooltips.Transforms_XForwarded_Name">
    <MudSelect Label="ⓘ Default Action" @bind-Value="Transform.XForwarded" For="@(() => Transform.XForwarded)" Variant="Variant.Outlined" Margin="Margin.Dense">
        @foreach (ForwardedTransformAction item in Enum.GetValues(typeof(ForwardedTransformAction)))
        {
            <MudSelectItem Value="@item">@item.ToString()</MudSelectItem>
        }
    </MudSelect>
</TopToolTip>

<TopToolTip Text="@Tooltips.Transforms_XForwarded_For">
    <MudSelect Label="ⓘ For Header Action" @bind-Value="Transform.For" For="@(() => Transform.For)" Variant="Variant.Outlined" Margin="Margin.Dense">
        @foreach (ForwardedTransformAction item in Enum.GetValues(typeof(ForwardedTransformAction)))
        {
            <MudSelectItem Value="@((ForwardedTransformAction?)item)">@item.ToString()</MudSelectItem>
        }
    </MudSelect>
</TopToolTip>


<MudStack Spacing="2">
    <TopToolTip Text="@Tooltips.Transforms_RequestHeaderRouteValue_Name">
        <MudTextField Label="ⓘ Request Header"
                      @bind-Value="Transform.RequestHeaderRouteValue"
                      For="@(() => Transform.RequestHeaderRouteValue)"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense" />
    </TopToolTip>

    <MudStack Row="true">

        <TopToolTip Text="@Tooltips.Transforms_RequestHeaderRouteValue_ChangeType" RootClass="mt-2">
            <MudToggleGroup T="BasicTransformAction" @bind-Value="ActionType" Outlined="true" Delimiters="true" Size="Size.Medium" Color="@ColorResolver.Buttons.Toggle">
                <MudToggleItem Value="@BasicTransformAction.Set">Replace</MudToggleItem>
                <MudToggleItem Value="@BasicTransformAction.Append">Add</MudToggleItem>
            </MudToggleGroup>
        </TopToolTip>

        @if (ActionType == BasicTransformAction.Set)
        {
            <TopToolTip Text="@Tooltips.Transforms_RequestHeaderRouteValue_Set" RootClass="d-flex flex-grow-1">
                <MudTextField Label="ⓘ Route value"
                              @bind-Value="Transform.Set"
                              For="@(() => Transform.Set)"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense" />
            </TopToolTip>
        }
        else
        {
            <TopToolTip Text="@Tooltips.Transforms_RequestHeaderRouteValue_Append" RootClass="d-flex flex-grow-1">
                <MudTextField Label="ⓘ Value"
                              @bind-Value="Transform.Append"
                              For="@(() => Transform.Append)"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense" />
            </TopToolTip>
        }
    </MudStack>
</MudStack>

@code {
    [Parameter, EditorRequired]
    public required RequestHeaderRouteValueTransform Transform { get; set; }

    private BasicTransformAction ActionType
    {
        get => Transform.Append != null ? BasicTransformAction.Append : BasicTransformAction.Set;
        set
        {
            if (value == BasicTransformAction.Set)
            {
                Transform.Append = null;
                Transform.Set = string.Empty;
            }
            else
            {
                Transform.Set = null;
                Transform.Append = string.Empty;
            }
        }
    }
}
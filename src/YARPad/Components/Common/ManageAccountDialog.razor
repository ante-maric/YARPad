@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage

@inject NavigationManager NavigationManager
@inject IJSRuntime JS

@if (IsAccountPage)
{
    <div class="mud-dialog-container mud-dialog-center" style="backdrop-filter: blur(10px);">
        <div class="mud-overlay mud-overlay-dialog mud-skip-overlay-section mud-skip-overlay-positioning" />
        <div class="mud-dialog mud-dialog-width-md mud-dialog-width-full sticky-header-dialog border mud-border-primary-darken">
            <div class="mud-dialog-title">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@IconResolver.Symbol.User" />
                    <MudText Typo="Typo.h6">Account</MudText>
                </MudStack>
                <button onclick="YarpadManageNavigation.goBack()" class="mud-button-root mud-icon-button mud-ripple mud-ripple-icon mud-button-close">
                    <span class="mud-icon-button-label">
                        <MudIcon Icon="@IconResolver.Buttons.Close" />
                    </span>
                </button>
            </div>
            <div class="mud-dialog-content" style="overflow-y: auto;">
                @ChildContent
            </div>
            <div class="mud-dialog-actions" style="padding: 8px; display: flex; justify-content: flex-end;">
                <button onclick="YarpadManageNavigation.goBack()" class="mud-button-root mud-button mud-button-text mud-button-text-primary mud-button-text-size-medium mud-ripple">
                    <span class="mud-button-label">Close</span>
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [CascadingParameter]
    private RouteData? RouteData { get; set; }

    private bool IsAccountPage => RouteData?.PageType?.Namespace?.StartsWith("CodingCell.YARPad.Components.Account", StringComparison.Ordinal) == true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if (firstRender)
            return;

        await StoreOriginUrlAsync();
    }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        NavigationManager.LocationChanged += HandleLocationChanged;
    }

    private async void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        await StoreOriginUrlAsync();
    }

    private async Task StoreOriginUrlAsync()
    {
        var url = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        if (!url.StartsWith("Account/Manage"))
            await JS.InvokeVoidAsync("sessionStore.set", "yarpad_manage_origin", url);
    }
}

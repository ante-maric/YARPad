@inject IDialogService DialogService

<MudCard Elevation="3" Class="border-t-2 mud-border-primary">
    <MudCardHeader>
        <CardHeaderContent>
            <MudStack Spacing="0">
                <MudText Typo="Typo.h6">@Definition.Type</MudText>
                @if (!string.IsNullOrWhiteSpace(Definition.Description))
                {
                    <MudText Typo="Typo.caption">@Definition.Description</MudText>
                }
            </MudStack>
        </CardHeaderContent>
        <CardHeaderActions>
            <MudStack Row="true" Spacing="0">
                <MudIconButton Icon="@IconResolver.Buttons.Edit" OnClick="EditAsync" />
                <MudMenu Icon="@IconResolver.Buttons.More">
                    <MudMenuItem Icon="@IconResolver.Buttons.Clone" OnClick="CloneAsync">Clone</MudMenuItem>
                    <MudMenuItem Icon="@IconResolver.Buttons.Delete" OnClick="DeleteAsync">Delete</MudMenuItem>
                </MudMenu>
            </MudStack>
        </CardHeaderActions>
    </MudCardHeader>
    <MudCardContent>
        @if (Definition.Parameters?.Count > 0)
        {
            <MudGrid Spacing="2">
                @foreach (var parameter in Definition.Parameters)
                {
                    <MudItem xs="12" sm="6" md="4">
                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Start">
                            <MudIcon Icon="@IconResolver.Symbol.Label" Class="@ColorResolver.Symbol.Label" />
                            <MudStack Spacing="0">
                                <MudText Typo="Typo.subtitle2">@parameter.Name</MudText>
                                @if (!string.IsNullOrWhiteSpace(parameter.Description))
                                {
                                    <MudText Typo="Typo.caption">@parameter.Description</MudText>
                                }
                            </MudStack>
                        </MudStack>
                    </MudItem>
                }
            </MudGrid>
        }
        else
        {
            <MudText Typo="Typo.caption" Color="Color.Info">No parameters defined.</MudText>
        }
    </MudCardContent>
</MudCard>

@code {
    [Parameter, EditorRequired]
    public required CustomTransformDefinition Definition { get; set; }

    [Parameter, EditorRequired]
    public required List<string> UsedBy { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<CustomTransformDefinition> OnEdit { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<CustomTransformDefinition> OnClone { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<CustomTransformDefinition> OnDelete { get; set; }

    private async Task EditAsync() => await OnEdit.InvokeAsync(Definition);

    private async Task CloneAsync() => await OnClone.InvokeAsync(Definition);

    private async Task DeleteAsync()
    {
        if (UsedBy.Count > 0)
        {
            var options = new DialogOptions { CloseOnEscapeKey = true, CloseButton = true };
            await DialogService.ShowMessageBoxAsync(
                "Cannot Delete " + Definition.Type,
                $"This custom transform is used by {UsedBy.Count} route(s) and cannot be deleted. Remove the references first.",
                "OK",
                options: options);
            return;
        }

        var confirmOptions = new DialogOptions { CloseOnEscapeKey = true, CloseButton = false };
        var result = await DialogService.ShowMessageBoxAsync("Delete " + Definition.Type, "Are you sure you want to delete this custom transform?", "Yes", "No", options: confirmOptions);

        if (result == true)
            await OnDelete.InvokeAsync(Definition);
    }
}

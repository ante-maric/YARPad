@inject CustomTransformParameterDefinitionValidator Validator

<MudDialog Class="border mud-border-primary-darken">
    <TitleContent>
        <MudText Typo="Typo.h6">Parameter</MudText>
    </TitleContent>

    <DialogContent>
        <MudForm @ref="_form" Model="@Parameter" Validation="_validationHandler.ValidateAsync">
            <MudStack Spacing="2">
                <MudTextField Label="Name"
                              @bind-Value="Parameter.Name"
                              For="@(() => Parameter.Name)"
                              Margin="Margin.Dense"
                              Variant="Variant.Outlined" />

                <MudTextField Label="Description"
                              @bind-Value="Parameter.Description"
                              For="@(() => Parameter.Description)"
                              Margin="Margin.Dense"
                              Variant="Variant.Outlined" />
            </MudStack>
        </MudForm>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="@ColorResolver.Buttons.Save" OnClick="Save">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private MudForm? _form;
    private DeferredValidationHandler<CustomTransformParameterDefinition>? _validationHandler;

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public string? OriginalName { get; set; }

    [Parameter, EditorRequired]
    public required CustomTransformParameterDefinition Parameter { get; set; }

    [Parameter, EditorRequired]
    public CustomTransformDefinition Transform { get; set; }

    private async Task Save()
    {
        if (_validationHandler == null || _form == null)
            return;

        await _validationHandler.ExecuteValidationAsync(() => _form.ValidateAsync());

        if (!_form.IsValid)
            return;

        MudDialog.Close(DialogResult.Ok(Parameter));
    }

    private void Cancel() => MudDialog.Cancel();

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        _validationHandler = new(Validator);
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        Validator.ContextData[ValidatorContext.CustomTransform.IS_EDITING_PARAMETER] = true;
        Validator.ContextData[ValidatorContext.CustomTransform.ORIGINAL_PARAMETER_NAME] = OriginalName;
        Validator.ContextData[ValidatorContext.CustomTransform.MODEL] = Transform;
    }
}

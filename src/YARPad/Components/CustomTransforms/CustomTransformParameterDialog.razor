@implements IDisposable
@inject CustomTransformParameterDefinitionValidator Validator

<MudDialog Class="border mud-border-primary-darken">
    <TitleContent>
        <MudText Typo="Typo.h6">Parameter</MudText>
    </TitleContent>

    <DialogContent>
        <MudForm @ref="_form" Model="@Parameter" Validation="_validationHandler?.Validation">
            <MudStack Spacing="2">
                <MudTextField Label="Name"
                              @bind-Value="Parameter.Name"
                              For="@(() => Parameter.Name)"
                              Margin="Margin.Dense"
                              Variant="Variant.Outlined" />

                <MudTextField Label="Description"
                              @bind-Value="Parameter.Description"
                              For="@(() => Parameter.Description)"
                              Margin="Margin.Dense"
                              Variant="Variant.Outlined" />
            </MudStack>
        </MudForm>

        <ValidationErrorList Errors="@(_validationHandler?.UnclaimedErrors ?? [])" />
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="@ColorResolver.Buttons.Save" OnClick="Save" Disabled="@(_validationHandler?.IsValidating == true)">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private MudForm? _form;
    private DeferredValidationHandler<CustomTransformParameterDefinition>? _validationHandler;

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public string? OriginalName { get; set; }

    [Parameter, EditorRequired]
    public required CustomTransformParameterDefinition Parameter { get; set; }

    [Parameter, EditorRequired]
    public CustomTransformDefinition Transform { get; set; }

    private async Task Save()
    {
        if (_validationHandler == null || _form == null)
            return;

        if (!await _validationHandler.ValidateAsync(Parameter, () => _form.ValidateAsync(), () => _form.IsValid))
            return;

        MudDialog.Close(DialogResult.Ok(Parameter));
    }

    private void Cancel() => MudDialog.Cancel();

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        _validationHandler = new(Validator);
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        var contextData = ValidatorContextData.CreateCustomTransformParameter(OriginalName, Transform);

        _validationHandler?.SetContextData(contextData);
    }

    void IDisposable.Dispose() => _validationHandler?.Dispose();
}

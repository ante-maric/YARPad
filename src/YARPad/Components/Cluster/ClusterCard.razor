@using Yarp.ReverseProxy.LoadBalancing

@inject IDialogService DialogService
@inject IRouteEditorService RouteEditorService

<MudCard Elevation="3" Class="border-t-2 mud-border-primary-darken">
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Typo="Typo.h6">@Cluster.ClusterID</MudText>
        </CardHeaderContent>
        <CardHeaderActions>
            <MudStack Row="true" Spacing="0">
                <MudIconButton Icon="@IconResolver.Buttons.Edit" OnClick="EditAsync" />
                <MudMenu Icon="@IconResolver.Buttons.More">
                    <MudMenuItem Icon="@IconResolver.Buttons.Clone" OnClick="CloneAsync">Clone</MudMenuItem>
                    <MudMenuItem Icon="@IconResolver.Buttons.Delete" OnClick="DeleteAsync">Delete</MudMenuItem>
                </MudMenu>
            </MudStack>
        </CardHeaderActions>
    </MudCardHeader>
    <MudCardContent Class="pb-0">
        <MudGrid Class="mb-4">
            <MudItem xs="12" sm="4">
                <MudStack Row="true" AlignItems="AlignItems.Start" Spacing="2">
                    <TopToolTip Text="@Cluster.LoadBalancingPolicy.HumanizeTitle()" Delay="0">
                        <MudIcon Size="Size.Large"
                                 Icon="@IconResolver.GetLoadBalancingPolicyIcon(Cluster.LoadBalancingPolicy)"
                                 Class="@ColorResolver.GetLoadBalancingPolicyColorClass(Cluster.LoadBalancingPolicy)" />
                    </TopToolTip>
                    <MudStack Spacing="0">
                        @if (Cluster.Destinations.Count > 0)
                        {
                            var visibleCount = Cluster.Destinations.Count > 5 ? 4 : Cluster.Destinations.Count;
                            @foreach (var destination in Cluster.Destinations.Take(visibleCount))
                            {
                                <MudLink Typo="Typo.subtitle1" Href="@destination.Address" Target="_blank" Color="Color.Default">@destination.Address</MudLink>
                            }

                            @if (Cluster.Destinations.Count > 5)
                            {
                                <MudText Typo="Typo.subtitle1">@($"+{Cluster.Destinations.Count - 4} more")</MudText>
                            }
                        }
                        else
                        {
                            <MudText Typo="Typo.subtitle1">No destinations</MudText>
                        }
                    </MudStack>
                </MudStack>
            </MudItem>
            <MudItem xs="12" sm="4" Class="d-flex justify-center">
                <DataField Name="Used By" HasData="@(UsedBy.Count > 0)">
                    <MudStack Spacing="0">
                        @if (UsedBy.Count > 0)
                        {
                            var visibleCount = UsedBy.Count > 4 ? 3 : UsedBy.Count;
                            @for (int i = 0; i < visibleCount; i++)
                            {
                                var routeID = UsedBy[i];
                                <MudLink OnClick="@(() => OpenRelatedEntityEditorAsync(routeID))">@routeID</MudLink>
                            }

                            @if (UsedBy.Count > 4)
                            {
                                <MudLink OnClick="@ShowAllUsedByAsync">@($"+{UsedBy.Count - 3} more")</MudLink>
                            }
                        }
                    </MudStack>
                </DataField>
            </MudItem>
            <MudItem xs="12" sm="4">
                @if (Cluster.OptionalSectionSwitches.Any(x => x.IsEnabled))
                {
                    <MudStack Row="true" Spacing="0" Wrap="Wrap.Wrap" Justify="Justify.Center">
                        @foreach (var sectionSwitch in Cluster.OptionalSectionSwitches.Where(x => x.IsEnabled))
                        {
                            <MudChip T="string" Variant="Variant.Text" Class="@sectionSwitch.Section.ToChipColorClasses()" Size="Size.Medium">@sectionSwitch.Section.HumanizeEnum()</MudChip>
                        }
                    </MudStack>
                }
                else
                {
                    <MudStack Row="true" Justify="Justify.Center">
                        <MudChip T="string" Variant="Variant.Text">No customizations</MudChip>
                    </MudStack>
                }
            </MudItem>
        </MudGrid>

        <div class="ml-n4 mr-n4 rounded" style="min-height:0;">
            <MudExpansionPanel Gutters="false" Class="pl-4 pr-4" Style="background-color:var(--mud-palette-dark);" Dense="true" HeaderClass="thin-expand-header">
                <ChildContent>
                    <MudGrid Class="pa-0 pb-4">
                        <MudItem xs="3">
                            <ConfigSection Title="Session Affinity"
                                           Icon="@ClusterConfigSection.SessionAffinity.ToIcon()"
                                           IconColorClass="@GetSectionIconColorClass(ClusterConfigSection.SessionAffinity)"
                                           ChipColorClasses="@GetSectionChipColorClasses(ClusterConfigSection.SessionAffinity)"
                                           ContentClass="ml-6">
                                @if (!IsSessionAffinityConfigured())
                                {
                                    <MudText Class="ml-7" Typo="Typo.caption">Not set</MudText>
                                }
                                else
                                {
                                    <MudStack Spacing="1">
                                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                                            <TopToolTip Delay="0" Text="@Cluster.SessionAffinity.Policy.HumanizeTitle()">
                                                <MudIcon Icon="@IconResolver.GetSessionAffinityPolicyIcon(Cluster.SessionAffinity.Policy!)"
                                                         Class="@ColorResolver.GetSessionAffinityPolicyColorClass(Cluster.SessionAffinity.Policy!)"
                                                         Size="Size.Small" />
                                            </TopToolTip>
                                            <MudText Typo="Typo.caption">@Cluster.SessionAffinity.AffinityKeyName</MudText>
                                        </MudStack>
                                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                                            <TopToolTip Delay="0" Text="@Tooltips.ClusterCard_SessionAffinity_OnFailure">
                                                <MudIcon Icon="@IconResolver.GetSessionAffinityFailurePolicyIcon(Cluster.SessionAffinity.FailurePolicy!)"
                                                         Class="@ColorResolver.GetSessionAffinityFailurePolicyColorClass(Cluster.SessionAffinity.FailurePolicy!)"
                                                         Size="Size.Small" />
                                            </TopToolTip>
                                            <MudText Typo="Typo.caption">@Cluster.SessionAffinity.FailurePolicy.HumanizeTitle()</MudText>
                                        </MudStack>
                                    </MudStack>
                                }
                            </ConfigSection>
                        </MudItem>
                        <MudItem xs="3">
                            <ConfigSection Title="Health Checks" 
                                           Icon="@ClusterConfigSection.HealthCheck.ToIcon()" 
                                           IconColorClass="@GetSectionIconColorClass(ClusterConfigSection.HealthCheck)"
                                           ChipColorClasses="@GetSectionChipColorClasses(ClusterConfigSection.HealthCheck)">
                                @if (!IsHealthCheckConfigured())
                                {
                                    <MudText Class="ml-7" Typo="Typo.caption">Not set</MudText>
                                }
                                else
                                {
                                    <MudStack Spacing="1" Class="ml-6">
                                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                                            <TopToolTip Delay="0" Text="@Tooltips.ClusterCard_HealthCheck_AvailableDestinationPolicy">
                                                <MudIcon Icon="@IconResolver.GetAvailableDestinationsPolicyIcon(Cluster.HealthCheck.AvailableDestinationsPolicy)"
                                                         Class="@ColorResolver.GetAvailableDestinationsPolicyColorClass(Cluster.HealthCheck.AvailableDestinationsPolicy)"
                                                         Size="Size.Small" />
                                            </TopToolTip>
                                            <MudText Typo="Typo.caption">@Cluster.HealthCheck.AvailableDestinationsPolicy.HumanizeTitle("Not set")</MudText>
                                        </MudStack>
                                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                                            <MudIcon Icon="@Cluster.HealthCheck.Active.Enabled.ToIcon()"
                                                     Color="@Cluster.HealthCheck.Active.Enabled.ToColor()"
                                                     Size="Size.Small" />
                                            <MudText Typo="Typo.caption">Active</MudText>
                                        </MudStack>
                                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                                            <MudIcon Icon="@Cluster.HealthCheck.Passive.Enabled.ToIcon()"
                                                     Color="@Cluster.HealthCheck.Passive.Enabled.ToColor()"
                                                     Size="Size.Small" />
                                            <MudText Typo="Typo.caption">Passive</MudText>
                                        </MudStack>
                                    </MudStack>
                                }
                            </ConfigSection>
                        </MudItem>
                        <MudItem xs="3">
                            <ConfigSection Title="Http Client" 
                                           Icon="@ClusterConfigSection.HttpClient.ToIcon()" 
                                           IconColorClass="@GetSectionIconColorClass(ClusterConfigSection.HttpClient)"
                                           ChipColorClasses="@GetSectionChipColorClasses(ClusterConfigSection.HttpClient)">
                                @if (!IsHttpClientConfigured())
                                {
                                    <MudText Class="ml-7" Typo="Typo.caption">Not set</MudText>
                                }
                                else
                                {
                                    <MudStack Spacing="1" Class="ml-6">
                                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                                            <MudIcon Icon="@IconResolver.GetSslValidationIcon(Cluster.HttpClient.DangerousAcceptAnyServerCertificate != true)"
                                                     Color="@ColorResolver.GetSslValidationColor(Cluster.HttpClient.DangerousAcceptAnyServerCertificate != true)"
                                                     Size="Size.Small" />
                                            <MudText Typo="Typo.caption">Ssl Validation</MudText>
                                        </MudStack>
                                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                                            <MudIcon Icon="@IconResolver.GetWebProxyIcon(Cluster.HttpClient.WebProxy.Address != null)"
                                                     Color="@ColorResolver.GetWebProxyColor(Cluster.HttpClient.WebProxy.Address != null)"
                                                     Size="Size.Small" />
                                            <MudText Typo="Typo.caption">Web Proxy</MudText>
                                        </MudStack>
                                    </MudStack>
                                }
                            </ConfigSection>
                        </MudItem>
                        <MudItem xs="3">
                            <ConfigSection Title="Http Request" 
                                           Icon="@ClusterConfigSection.HttpRequest.ToIcon()" 
                                           IconColorClass="@GetSectionIconColorClass(ClusterConfigSection.HttpRequest)"
                                           ChipColorClasses="@GetSectionChipColorClasses(ClusterConfigSection.HttpRequest)">
                                @if (!IsHttpRequestConfigured())
                                {
                                    <MudText Class="ml-7" Typo="Typo.caption">Not set</MudText>
                                }
                                else
                                {
                                    <MudStack Spacing="1" Class="ml-6">
                                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                                            <TopToolTip Delay="0" Text="@Tooltips.ClusterCard_HttpRequest_ActivityTimeout">
                                                <MudIcon Icon="@IconResolver.Symbol.Timeout"
                                                         Color="@ColorResolver.Symbol.Timeout"
                                                         Size="Size.Small" />
                                            </TopToolTip>
                                            <MudText Typo="Typo.caption">@((Cluster.HttpRequest.ActivityTimeout ?? TimeSpan.FromSeconds(100)).ToString())</MudText>
                                        </MudStack>
                                        @if (Cluster.HttpRequest.VersionPolicy != null && Cluster.HttpRequest.Version != null)
                                        {
                                            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                                                <TopToolTip Delay="0" Text="@Cluster.HttpRequest.VersionPolicy.HumanizeEnum()">
                                                    <MudIcon Icon="@Cluster.HttpRequest.VersionPolicy.ToIcon()"
                                                             Class="@Cluster.HttpRequest.VersionPolicy.ToColorClass()"
                                                             Size="Size.Small" />
                                                </TopToolTip>
                                                <MudText Typo="Typo.caption">@($"v{Cluster.HttpRequest.Version.ToString(2)}")</MudText>
                                            </MudStack>
                                        }
                                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                                            <MudIcon Icon="@Cluster.HttpRequest.AllowResponseBuffering.ToIcon()"
                                                     Color="@Cluster.HttpRequest.AllowResponseBuffering.ToColor()"
                                                     Size="Size.Small" />
                                            <MudText Typo="Typo.caption">Response Buffering</MudText>
                                        </MudStack>
                                    </MudStack>
                                }
                            </ConfigSection>
                        </MudItem>
                    </MudGrid>
                </ChildContent>
            </MudExpansionPanel>
        </div>

    </MudCardContent>
</MudCard>

@code {
    [Parameter, EditorRequired]
    public required ClusterModel Cluster { get; set; }

    [Parameter, EditorRequired]
    public required List<string> UsedBy { get; set; }

    [Parameter, EditorRequired]
    public required Guid ConfigurationProfileID { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<ClusterModel> OnEdit { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<ClusterModel> OnClone { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<ClusterModel> OnDelete { get; set; }

    private string GetSectionIconColorClass(ClusterConfigSection section)
    {
        return Cluster.SectionSwitches[section].IsEnabled
            ? section.ToIconColorClass()
            : YarpadColor.Gray;
    }

    private string GetSectionChipColorClasses(ClusterConfigSection section)
    {
        return Cluster.SectionSwitches[section].IsEnabled
            ? section.ToChipColorClasses()
            : YarpadColor.Gray;
    }

    private bool IsSessionAffinityConfigured() => Cluster.SessionAffinity.Policy != null;

    private bool IsHealthCheckConfigured() =>
        Cluster.HealthCheck.Active.Enabled != null ||
        Cluster.HealthCheck.Passive.Enabled != null ||
        Cluster.HealthCheck.AvailableDestinationsPolicy != null;

    private bool IsHttpClientConfigured() =>
        Cluster.HttpClient.SslProtocols?.Any() == true ||
        Cluster.HttpClient.DangerousAcceptAnyServerCertificate != null ||
        Cluster.HttpClient.MaxConnectionsPerServer != null ||
        Cluster.HttpClient.WebProxy?.Address != null ||
        Cluster.HttpClient.EnableMultipleHttp2Connections != null ||
        Cluster.HttpClient.RequestHeaderEncoding != null ||
        Cluster.HttpClient.ResponseHeaderEncoding != null;

    private bool IsHttpRequestConfigured() =>
        Cluster.HttpRequest.ActivityTimeout != null ||
        Cluster.HttpRequest.Version != null ||
        Cluster.HttpRequest.AllowResponseBuffering != null;

    private async Task EditAsync() => await OnEdit.InvokeAsync(Cluster);

    private async Task CloneAsync() => await OnClone.InvokeAsync(Cluster);

    private async Task DeleteAsync()
    {
        if (UsedBy.Count > 0)
        {
            var options = new DialogOptions { CloseOnEscapeKey = true, CloseButton = true };
            await DialogService.ShowMessageBoxAsync(
                "Cannot Delete " + Cluster.ClusterID,
                $"This cluster is referenced by {UsedBy.Count} route(s) and cannot be deleted. Remove the references first.",
                "OK",
                options: options);
            return;
        }

        var confirmOptions = new DialogOptions { CloseOnEscapeKey = true, CloseButton = false };
        var result = await DialogService.ShowMessageBoxAsync("Delete " + Cluster.ClusterID, "Are you sure you want to delete this cluster?", "Yes", "No", options: confirmOptions);

        if (result == true)
            await OnDelete.InvokeAsync(Cluster);
    }

    private async Task OpenRelatedEntityEditorAsync(string entityID)
    {
        await RouteEditorService.OpenAsync(ConfigurationProfileID, entityID, true);
    }

    private async Task ShowAllUsedByAsync()
    {
        var parameters = new DialogParameters<RelationshipLinksDialog>
        {
            { x => x.Links, UsedBy },
            { x => x.OnLinkClick, EventCallback.Factory.Create<string>(this, OpenRelatedEntityEditorAsync) }
        };
        var options = new DialogOptions { CloseOnEscapeKey = true, CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };

        await DialogService.ShowAsync<RelationshipLinksDialog>("Used By", parameters, options);
    }
}

@inject DestinationValidator Validator

<MudDialog Class="sticky-header-dialog border mud-border-primary-darken">
    <TitleContent>
        <MudText Typo="Typo.h6">Destination Editor</MudText>
    </TitleContent>

    <DialogContent>
        <MudForm @ref="_form" Model="@Destination" Validation="_validationHandler.ValidateAsync">
            <MudStack Spacing="2">
                <MudTextField
                    Label="Identifier"
                    @bind-Value="Destination.ID"
                    For="@(() => Destination.ID)"
                    Margin="Margin.Dense"
                    Variant="Variant.Outlined" />
                <MudSwitch T="bool"
                           Label="Enabled"
                           @bind-Value="Destination.IsEnabled"
                           Color="@ColorResolver.Buttons.Switch" />
                <TopToolTip Text="@Tooltips.Destination_Address">
                    <MudTextField
                        Label="ⓘ Address"
                        @bind-Value="Destination.Address"
                        For="@(() => Destination.Address)"
                        Margin="Margin.Dense"
                        Clearable="true"
                        Variant="Variant.Outlined" />
                </TopToolTip>
                <TopToolTip Text="@Tooltips.Destination_HostHeader">
                    <MudTextField
                        Label="ⓘ Host Header"
                        @bind-Value="Destination.Host"
                        For="@(() => Destination.Host)"
                        Margin="Margin.Dense"
                        Clearable="true"
                        Variant="Variant.Outlined" />
                </TopToolTip>
                <TopToolTip Text="@Tooltips.Destination_HealthUrl">
                    <MudTextField
                        Label="ⓘ Health URL"
                        @bind-Value="Destination.Health"
                        For="@(() => Destination.Health)"
                        Margin="Margin.Dense"
                        Clearable="true"
                        Variant="Variant.Outlined" />
                </TopToolTip>

                <MudText Typo="Typo.h6" Class="mt-4 mb-2">Metadata</MudText>
                <CascadingValue Value="@Destination">
                    <MetadataEditor TParent="DestinationModel"
                                    Metadata="@Destination.Metadata"
                                    ForMetadata="@(() => Destination.Metadata)"
                                    SuggestedKeys="@SuggestedMetadataKeys"
                                    IsEnabled="true" />
                </CascadingValue>
            </MudStack>
        </MudForm>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="@ColorResolver.Buttons.Save" OnClick="Save">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private MudForm? _form;
    private DeferredValidationHandler<DestinationModel>? _validationHandler;

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public string? DestinationID { get; set; }

    [Parameter, EditorRequired]
    public required ClusterModel Cluster { get; set; }

    [Parameter, EditorRequired]
    public required DestinationModel Destination { get; set; }

    private List<string> SuggestedMetadataKeys { get; set; } = [];

    private async Task Save()
    {
        if (_validationHandler == null || _form == null)
            return;

        await _validationHandler.ExecuteValidationAsync(() => _form.ValidateAsync());

        if (!_form.IsValid)
            return;

        MudDialog.Close(DialogResult.Ok(Destination));
    }

    private void Cancel() => MudDialog.Cancel();

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        _validationHandler = new(Validator);
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        Validator.ContextData[ValidatorContext.Cluster.IS_EDITING_DESTINATION] = true;
        Validator.ContextData[ValidatorContext.Destination.ORIGINAL_ID] = DestinationID;
        Validator.ContextData[ValidatorContext.Cluster.MODEL] = Cluster;
    }
}
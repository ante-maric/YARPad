@inject ConfigurationProfileValidator Validator

<MudDialog Class="border mud-border-primary-darken">
    <TitleContent>
        <MudText Typo="Typo.h6">Configuration Editor</MudText>
    </TitleContent>

    <DialogContent>
        <MudForm @ref="_form" Model="@Profile" Validation="_validationHandler.ValidateAsync">
            <MudStack Spacing="2">
                <MudTextField Label="Name"
                              @bind-Value="Profile.Name"
                              For="@(() => Profile.Name)"
                              Margin="Margin.Dense"
                              Variant="Variant.Outlined" />
                <MudTextField Label="Description"
                              @bind-Value="Profile.Description"
                              For="@(() => Profile.Description)"
                              Margin="Margin.Dense"
                              Lines="3"
                              Variant="Variant.Outlined" />
            </MudStack>
        </MudForm>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="@ColorResolver.Buttons.Save" OnClick="Save">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private MudForm? _form;
    private DeferredValidationHandler<ConfigurationProfile>? _validationHandler;

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter, EditorRequired]
    public required ConfigurationProfile Profile { get; set; }

    private async Task Save()
    {
        if (_validationHandler == null || _form == null)
            return;

        await _validationHandler.ExecuteValidationAsync(() => _form.ValidateAsync());

        if (!_form.IsValid)
            return;

        MudDialog.Close(DialogResult.Ok(Profile));
    }

    private void Cancel() => MudDialog.Cancel();

    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        _validationHandler = new(Validator);
    }
}

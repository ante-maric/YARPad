@implements IDisposable
@inject IPolicyValidatorFactory ValidatorFactory

<MudDialog Class="border mud-border-primary-darken">
    <TitleContent>
        <MudText Typo="Typo.h6">Policy Editor</MudText>
    </TitleContent>

    <DialogContent>
        <MudForm @ref="_form" Model="@Policy" Validation="_validationHandler?.Validation">
            <MudStack Spacing="2">
                <MudTextField
                    Label="Identifier"
                    @bind-Value="Policy.ID"
                    For="@(() => Policy.ID)"
                    Margin="Margin.Dense"
                    Variant="Variant.Outlined" />
                <MudTextField
                    Label="Description"
                    @bind-Value="Policy.Description"
                    For="@(() => Policy.Description)"
                    Margin="Margin.Dense"
                    Lines="3"
                    Variant="Variant.Outlined" />
            </MudStack>
        </MudForm>

        <ValidationErrorList Errors="@(_validationHandler?.UnclaimedErrors ?? [])" />
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="@ColorResolver.Buttons.Save" OnClick="Save" Disabled="@(_validationHandler?.IsValidating == true)">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private MudForm? _form;
    private MudValidator<PolicyInfo>? _validator;
    private DeferredValidationHandler<PolicyInfo>? _validationHandler;
    private PolicyType? _validatorPolicyType;

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public string? PolicyID { get; set; }

    [Parameter, EditorRequired]
    public PolicyType PolicyType { get; set; }

    [Parameter, EditorRequired]
    public required PolicyInfo Policy { get; set; }

    [Parameter, EditorRequired]
    public Guid ConfigurationProfileID { get; set; }

    private async Task Save()
    {
        if (_validationHandler == null || _form == null)
            return;

        Policy.Name = Policy.ID.HumanizeTitle();

        if (!await _validationHandler.ValidateAsync(Policy, () => _form.ValidateAsync(), () => _form.IsValid))
            return;

        MudDialog.Close(DialogResult.Ok(Policy));
    }

    private void Cancel() => MudDialog.Cancel();

    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        // The validator depends on PolicyType, so only replace the handler when it changes.
        if (_validationHandler == null || _validatorPolicyType != PolicyType)
        {
            _validationHandler?.Dispose();
            _validator = ValidatorFactory.GetValidator(PolicyType);
            _validationHandler = new(_validator);
            _validatorPolicyType = PolicyType;
        }

        var contextData = ValidatorContextData.CreatePolicy(PolicyID, ConfigurationProfileID);
        _validationHandler.SetContextData(contextData);
    }

    void IDisposable.Dispose() => _validationHandler?.Dispose();
}
